# Make archetype-spinner the default Plymouth theme by writing
# /etc/plymouth/plymouthd.conf, which plymouthd reads ahead of
# /usr/share/plymouth/plymouthd.defaults (Theme=bgrt).
#
# We write the file rather than use `plymouth-set-default-theme`: that wrapper
# probes the runtime (plymouth --get-splash-plugin-path + a plugin-existence
# check) and exits non-zero WITHOUT writing the config in a bare build/initrd
# chroot (no running plymouthd/D-Bus). We do not (cannot) SHIP the file either:
# plymouth owns /etc/plymouth/plymouthd.conf, so packaging it would conflict.
# A scriptlet may freely overwrite another package's file.
#
# We OVERWRITE the whole file (not edit-in-place). The previous version tried to
# insert `Theme=` under an existing [Daemon] header with
# `sed '0,/^\[Daemon\]/s//.../'`; that empty-regex address-reuse idiom is NOT
# portable across sed implementations and silently no-op'd in the initrd build,
# leaving a bare `[Daemon]` with no Theme -> the boot splash fell back to bgrt.
# The stock file is only commented defaults, so clobbering it loses nothing; a
# fixed two-line body has zero parsing fragility and is fully idempotent.

_set_default_theme() {
	mkdir -p etc/plymouth
	printf '[Daemon]\nTheme=archetype-spinner\n' > etc/plymouth/plymouthd.conf
}

post_install() {
	_set_default_theme
}

post_upgrade() {
	_set_default_theme
}
