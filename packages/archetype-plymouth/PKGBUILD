# Maintainer: Josh Heretic <josh[at]archetype[dot]li>

# Ships the archetype-spinner Plymouth theme (Arch's spinner theme with the
# Archetype wordmark watermark, generated by archetype-logo.sh --plymouth) and
# makes it the default. The theme files are vendored here so the package is
# self-contained; regenerate with archetype-logo.sh --plymouth if the wordmark
# or palette changes.
#
# Default-theme mechanism: the .install scriptlet runs plymouth-set-default-theme
# (writes /etc/plymouth/plymouthd.conf Theme=), because plymouth OWNS both
# plymouthd.conf and plymouthd.defaults -- this package cannot ship either
# without a file conflict. mkosi runs pacman scriptlets during both the image
# and the default-initrd builds, so InitrdPackages=archetype-plymouth in
# archetype-build carries the theme + default into the initrd (where plymouthd
# actually starts).

pkgname=archetype-plymouth
pkgver=1
pkgrel=1
pkgdesc='Archetype Plymouth boot splash (archetype-spinner theme)'
arch=('any')
url='https://archetype.li'
license=('GPL')
depends=('plymouth')
install="${pkgname}.install"
# Vendored theme directory (tracked in this repo).
source=()
sha256sums=()

package() {
  local themedir="$pkgdir/usr/share/plymouth/themes/archetype-spinner"
  install -dm755 "$themedir"
  # Copy every theme asset (frames, prompt glyphs, watermark, .plymouth).
  cp -a "$startdir/archetype-spinner/." "$themedir/"
  # Normalize permissions (git may not preserve them for vendored files).
  find "$themedir" -type f -exec chmod 644 {} +
  find "$themedir" -type d -exec chmod 755 {} +
}
